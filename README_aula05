7. Script de Auditoria Bash

teste_seguranca.sh:

#!/bin/bash
echo "==================================================" > audit_seguranca.log
echo "  AUDITORIA DE SEGURANCA - BINARIO TECH           " >> audit_seguranca.log
echo "  Data/Hora: $(date)                              " >> audit_seguranca.log
echo "==================================================" >> audit_seguranca.log

echo -e "\n[TESTE 1] Acesso sem API Key (Esperado: 401)" >> audit_seguranca.log
curl -i http://localhost:3000/api/v1/motoristas >> audit_seguranca.log

echo -e "\n\n[TESTE 2] CNH Invalida < 11 digitos (Esperado: 400)" >> audit_seguranca.log
curl -i -X POST http://localhost:3000/api/v1/motoristas \
  -H "X-API-KEY: binario-tech-secret-2026" \
  -H "Content-Type: application/json" \
  -d '{"nome":"Erro CNH","cnh":"123","categoria":"B"}' >> audit_seguranca.log

echo -e "\n\n[TESTE 3] Rota Inexistente (Esperado: 404)" >> audit_seguranca.log
curl -i http://localhost:3000/api/v1/inexistente >> audit_seguranca.log

echo -e "\n\n[TESTE 4] Acesso Valido e Cadastro OK (Esperado: 201)" >> audit_seguranca.log
curl -i -X POST http://localhost:3000/api/v1/motoristas \
  -H "X-API-KEY: binario-tech-secret-2026" \
  -H "Content-Type: application/json" \
  -d '{"nome":"Juliana Martins","cnh":"11122233344","categoria":"D"}' >> audit_seguranca.log

echo -e "\n--------------------------------------------------" >> audit_seguranca.log
echo "Auditoria concluida com sucesso!" >> audit_seguranca.log

Comandos para rodar o script:

chmod +x teste_seguranca.sh
./teste_seguranca.sh
cat audit_seguranca.log

