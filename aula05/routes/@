t express = require('express');
const router = express.Router();

const manutencoes = [];

router.get('/', (req, res) => {
	  res.status(200).json({
		      sucesso: true,
		      total: manutencoes.length,
		      dados: manutencoes
		    });
});

router.post('/', (req, res) => {
	  const { placaCaminhao, descricao, valorOrcamento, dataOrcamento } = req.body;

	  if (!placaCaminhao || !descricao || !valorOrcamento) {
		      return res.status(400).json({
			            sucesso: false,
			            mensagem: 'Os campos placaCaminhao, descricao e valorOrcamento são obrigatórios.'
			          });
		    }

	  const novaManutencao = {
		      id: manutencoes.length + 1,
		      placaCaminhao,
		      descricao,
		      valorOrcamento: Number(valorOrcamento),
		      dataOrcamento: dataOrcamento || new Date().toISOString(),
		      status: 'Pendente'
		    };

	  manutencoes.push(novaManutencao);

	  res.status(201).json({
		      sucesso: true,
		      mensagem: 'Orçamento de manutenção cadastrado com sucesso!',
		      dados: novaManutencao
		    });
});

module.exports = router;
